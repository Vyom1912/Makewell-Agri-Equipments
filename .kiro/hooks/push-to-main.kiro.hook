{
  "enabled": true,
  "name": "Push to GitHub",
  "description": "Stages all changed files, commits with a timestamp message, and pushes to origin/main. Skips .env so secrets are never committed.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "cd \"f:\\makewell\\makewell-react\" ; git add -A ; git reset HEAD .env ; git diff --cached --quiet ; if ($LASTEXITCODE -eq 0) { Write-Host \"Nothing to commit.\" } else { $msg = \"update: $(Get-Date -Format 'yyyy-MM-dd HH:mm')\" ; git commit -m $msg ; git push origin main ; Write-Host \"Pushed to main.\" }",
    "timeout": 60
  }
}